{
  "name": "hangul-fuzzy",
  "version": "0.0.0",
  "description": "한글 초성·퍼지 검색과 매칭 위치(하이라이트) 반환",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "hangul",
    "korean",
    "fuzzy",
    "search",
    "choseong",
    "초성",
    "한글"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
